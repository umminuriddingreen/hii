  },
  {
    "id": "hii-rhino",
    "name": "HII Rhino",
    "summary": "HII-owned Rhino and Grasshopper execution, trusted job queue, logs, proof artifacts, and receipts.",
    "capabilities": [
      "hii.rhino.managed_job",
      "hii.rhino.bootstrap_action"
    ],
    "routes": [],
    "commands": [
      "npm run hii:rhino -- status",
      "npm run hii:rhino -- command <macro>",
      "npm run hii:rhino -- script <path>",
      "npm run hii:rhino -- grasshopper <path>",
      "hii runner init <name>",
      "hii runner start --once"
    ],
    "files": [
      "lib/server/hii-rhino-jobs.ts",
      "lib/server/runners.ts",
      "scripts/hii-rhino.mjs"
    ],
    "runnerSupport": {
      "requiredCapabilityId": "hii.rhino.managed_job",
      "expectedInputs": [
        "workflow",
        "prompt",
        "budget",
        "reserved quote"
      ],
      "expectedOutputs": [
        "runner transcript",
        "proof_artifacts.log",
        "completed or failed capability_jobs row"
      ],
      "proofArtifacts": [
        "log first; screenshot/model artifacts when available"
      ],
      "verificationCommands": [
        "npm run hii:rhino -- status",
        "hii runner start --once",
        "hii caps show",
        "npm run check"
      ]
    },
    "runtimeFiles": [
      "Supabase capability_runners",
      "Supabase capability_jobs runner fields",
      "~/hii/.hii/rhino-jobs.jsonl"
    ],
    "verification": [
      "npm run hii:rhino -- status",
      "node scripts/hii-cli.mjs runner start --once",
      "npm run check"
    ],
    "shipBoundary": "owned approved runners only; Rhino execution remains whitelisted and operator-reviewed"
  },
