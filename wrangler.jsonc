{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hii",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "HII_REMOTE_USER": "ummi"
  },
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "hii"
    }
  ],
  "routes": [
    {
      "pattern": "humaninformationinterface.com",
      "custom_domain": true
    },
    {
      "pattern": "www.humaninformationinterface.com",
      "custom_domain": true
    }
  ]
}
