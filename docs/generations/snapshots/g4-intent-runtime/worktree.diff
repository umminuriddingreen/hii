+      const title = stripHtml(match[2] || '');
+      const snippet = stripHtml(match[3] || '');
+      if (!title || !link) continue;
+      results.push({ title, link, snippet });
+    }
+    return formatResults(results);
+  } catch (error: any) {
+    return `SearxNG error: ${error?.message || String(error)}`;
+  }
