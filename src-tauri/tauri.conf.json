{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HII",
  "version": "0.1.0",
  "identifier": "com.ummi.hii",
  "build": {
    "beforeDevCommand": "npm run dev:web:tauri",
    "devUrl": "http://127.0.0.1:3042",
    "beforeBuildCommand": "npm run build:web:tauri",
    "frontendDist": "fallback"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "HII",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "../.hii-app/": "hii-app/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
