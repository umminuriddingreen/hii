<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(RhinoTargetFramework)</TargetFramework>
    <AssemblyName>HiiRhino.Core</AssemblyName>
    <RootNamespace>HiiRhino.Core</RootNamespace>
