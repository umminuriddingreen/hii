{
  "manifest_version": 3,
  "name": "HII Link Capture",
  "version": "0.1.0",
  "description": "Capture browser links into the local HII offline feed.",
  "permissions": ["activeTab", "contextMenus", "storage", "tabs"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://umminuriddingreen.com/*"
  ],
  "action": {
    "default_title": "Save to HII",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
