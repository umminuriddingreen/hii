{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hii-site-preview",
  "main": "workers/site/src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/api/*", "/download/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "HII_REMOTE_USER": "ummi"
  },
  "d1_databases": [
    {
      "binding": "WAITLIST",
      "database_name": "hii-waitlist",
      "database_id": "56e4c3ed-1c4c-4240-80a1-36ce8f4f372d",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "hii"
    }
  ]
  // Deliberately no production routes. The custom domain still points at the
  // deployed SvelteKit build; wrangler.production.jsonc records the route
  // ownership so the switch is one reviewed step, not a side effect of a deploy.
}
