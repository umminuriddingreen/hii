[
  {
    "id": "hii-core-loop",
    "name": "HII Core Loop",
    "summary": "Local user-proxy loop, OG context, y/n plan gate, and agent-readable context.",
    "capabilities": ["hii.loop.user_proxy", "hii.og.operational_graph", "hii.terminal.observe", "hii.board.task_kanban"],
    "routes": ["/", "/boards", "/console", "/api/context", "/api/og/status", "/api/board/tasks"],
    "commands": ["hii context --json", "hii og status", "hii loop once", "hii loop note", "hii loop decide", "hii board", "hii console"],
    "files": [
      "app/HiiNew.tsx",
      "app/page.tsx",
      "app/boards/page.tsx",
      "app/boards/BoardClient.tsx",
      "app/api/context/route.ts",
      "app/api/og/status/route.ts",
      "app/api/board/tasks/route.ts",
      "lib/server/hii-board.ts",
      "lib/server/hii-agent-context.ts",
      "scripts/hii-cli.mjs"
    ],
    "runtimeFiles": ["~/.hii/og/events.jsonl", "~/.hii/loop/decisions.jsonl", "~/.hii/loop/notes.jsonl", "~/.hii/board/tasks.jsonl"],
    "verification": ["node scripts/hii-cli.mjs loop once", "node scripts/hii-cli.mjs loop status", "node scripts/hii-cli.mjs board", "npm run build"],
    "shipBoundary": "local-only; exports manifests, never pushes or publishes"
  },
  {
