<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(RhinoTargetFramework)</TargetFramework>
    <AssemblyName>HiiRhino</AssemblyName>
    <RootNamespace>HiiRhino.Plugin</RootNamespace>
    <!-- Reported in the handshake as adapter_version and written into every
         advertisement, so it tracks the Rust crates rather than the SDK's 1.0.0
         default. -->
    <Version>0.1.0</Version>
    <!-- A Rhino plug-in is an ordinary assembly with a .rhp extension. -->
    <TargetExt>.rhp</TargetExt>
    <!-- Required for .NET Core plug-ins: emits the .deps.json Rhino's
         per-plug-in load context uses to resolve HiiRhino.Core next to us. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned below the installed Rhino (8.32) rather than floated to
         latest: an API that exists in this reference assembly is guaranteed to
         exist in the Rhino actually running. ExcludeAssets=runtime keeps
         RhinoCommon.dll out of the plug-in folder — if a second copy were
         loaded into the plug-in's own load context, every RhinoCommon type
         would fail to match Rhino's own and the errors read as impossible
         casts. -->
    <PackageReference Include="RhinoCommon" Version="8.29.26063.11001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HiiRhino.Core\HiiRhino.Core.csproj" />
  </ItemGroup>

</Project>
