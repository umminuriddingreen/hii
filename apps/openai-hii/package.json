{
  "name": "@hii/openai-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run check:server",
    "build:web": "vite build",
    "check": "npm run check:web && npm run check:server",
    "check:web": "tsc -p web/tsconfig.json --noEmit",
    "check:server": "tsc -p server/tsconfig.json --noEmit",
    "dev": "concurrently -k \"vite build --watch\" \"tsx watch server/src/index.ts\"",
    "start": "tsx server/src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.1.2",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
