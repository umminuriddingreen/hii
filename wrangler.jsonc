{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hii",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "humaninformationinterface.com",
      "custom_domain": true
    },
    {
      "pattern": "www.humaninformationinterface.com",
      "custom_domain": true
    }
  ]
}
