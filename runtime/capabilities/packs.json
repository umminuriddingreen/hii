[
  {
    "id": "hii-core-loop",
    "name": "HII Core Loop",
    "summary": "Local user-proxy loop, OG context, y/n plan gate, and agent-readable context.",
    "capabilities": [
      "hii.loop.user_proxy",
      "hii.og.operational_graph",
      "hii.terminal.observe",
      "hii.board.task_kanban"
    ],
    "routes": [],
    "commands": [
      "hii context --json",
      "hii og status",
      "hii loop once",
      "hii loop note",
      "hii loop decide",
      "hii board",
      "hii console"
    ],
    "files": [
      "lib/server/hii-board.ts",
      "lib/server/hii-agent-context.ts",
      "scripts/hii-cli.mjs"
    ],
    "runtimeFiles": [
      "~/.hii/og/events.jsonl",
      "~/.hii/loop/decisions.jsonl",
      "~/.hii/loop/notes.jsonl",
      "~/.hii/board/tasks.jsonl"
    ],
    "verification": [
      "node scripts/hii-cli.mjs loop once",
      "node scripts/hii-cli.mjs loop status",
      "node scripts/hii-cli.mjs board"
    ],
    "shipBoundary": "local-only; exports manifests, never pushes or publishes"
  },
  {
    "id": "hii-knowledge-workspace",
    "name": "HII Knowledge Workspace",
    "summary": "Local Markdown knowledge, deterministic links/tags/search, graph navigation, history, lifecycle controls, and receipts on ~/.hii/hii.db.",
    "capabilities": [
      "hii.knowledge.workspace"
    ],
    "routes": [],
    "commands": [
      "hii knowledge",
      "hii knowledge --open",
      "hii knowledge check"
    ],
    "files": [
      "lib/server/hii-knowledge.ts",
      "scripts/hii-knowledge-smoke.mjs"
    ],
    "runtimeFiles": [
      "~/.hii/hii.db knowledge_* tables"
    ],
    "verification": [
      "npm run hii:knowledge:check"
    ],
    "shipBoundary": "local-only knowledge state; importing reads user-selected files in the browser; export downloads locally; no sync or publish"
  },
  {
    "id": "hii-terminal",
