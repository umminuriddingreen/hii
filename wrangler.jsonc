{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hii",
  "main": "workers/public-site/build/worker/shim.mjs",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "sh scripts/build-public-worker.sh"
  },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "763841",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "hii"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REMOTE_ROOM",
        "class_name": "RemoteRoom"
      },
      {
        "name": "PERSONAL_ROOM",
        "class_name": "PersonalRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RemoteRoom"
      ]
    },
    {
      "tag": "v2-personal",
      "new_sqlite_classes": [
        "PersonalRoom"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "IDENTITY",
      "database_name": "hii-identity",
      "database_id": "c2ca577f-cfff-493e-8e7d-0fbe64c5daf3",
      "migrations_dir": "workers/public-site/migrations"
    }
  ],
  "routes": [
    {
      "pattern": "humaninformationinterface.com",
      "custom_domain": true
    },
    {
      "pattern": "www.humaninformationinterface.com",
      "custom_domain": true
    }
  ]
}
