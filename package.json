{
  "name": "hii",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "fabric:protocol:check": "cargo fmt --manifest-path fabric/protocol/Cargo.toml -- --check && cargo test --locked --manifest-path fabric/protocol/Cargo.toml && cargo clippy --locked --manifest-path fabric/protocol/Cargo.toml --all-targets -- -D warnings",
    "fabric:windows-receiver:check": "cargo fmt --manifest-path fabric/windows-receiver/Cargo.toml -- --check && cargo test --locked --manifest-path fabric/windows-receiver/Cargo.toml && cargo clippy --locked --manifest-path fabric/windows-receiver/Cargo.toml --all-targets -- -D warnings",
    "fabric:macos-capture:check": "swift test --package-path fabric/macos-capture && swift build -c release --package-path fabric/macos-capture",
    "fabric:check": "npm run fabric:protocol:check && npm run fabric:windows-receiver:check && npm run fabric:macos-capture:check",
    "runner:build": "cargo build --release -p hii-native-runner",
    "runner:check": "cargo test -p hii-native-runner && cargo clippy -p hii-native-runner --all-targets -- -D warnings",
    "postinstall": "node scripts/hii-postinstall.mjs",
    "readme:update": "node scripts/hii-readme-state.mjs --write",
    "readme:check": "node scripts/hii-readme-state.mjs --check",
    "hii:readme:check": "vitest run tests/unit/readme-state.test.ts",
    "demo:launch-proof": "node --experimental-strip-types scripts/hii-launch-proof-workspace.mjs",
    "hii:registry:scan": "node scripts/hii-registry-scan.mjs",
    "hii:registry:doctor": "node scripts/hii-registry-doctor.mjs",
    "hii:registry:export": "node scripts/hii-registry-export.mjs",
    "hii:codex-sync-schedule:check": "node --test scripts/hii-codex-sync-schedule.test.mjs",
    "hii:links:cache": "node scripts/hii-link-cache.mjs",
    "hii:admin-agent:plan": "node runtime/scripts/hii-admin-agent-plan.mjs",
    "hii:sdk:check": "node scripts/hii-sdk-contract-smoke.mjs",
    "hii:skills:check": "node scripts/hii-skill-registry-smoke.mjs",
    "hii:skill-replay:check": "node --experimental-strip-types scripts/hii-skill-replay-smoke.mjs",
    "hii:knowledge:check": "node --experimental-strip-types scripts/hii-knowledge-smoke.mjs",
    "hii:knowledge-runs:check": "node --experimental-strip-types scripts/hii-knowledge-run-smoke.mjs",
    "hii:knowledge:import": "node --experimental-strip-types scripts/hii-knowledge-import.mjs",
    "hii:memory:check": "vitest run tests/unit/hii-memory-workspace.test.ts",
    "hii:contextdock:check": "node --experimental-strip-types scripts/hii-contextdock-smoke.mjs",
    "hii:activation:check": "node --experimental-strip-types scripts/hii-activation-smoke.mjs",
    "hii:windows:check": "node --experimental-strip-types scripts/hii-window-state-smoke.mjs",
    "hii:rhino": "node scripts/hii-rhino.mjs",
    "hii:windows:preserve": "node --experimental-strip-types scripts/hii-windows-preservation-audit.mjs",
    "hii:windows:preserve:check": "vitest run tests/unit/windows-preservation-manifest.test.ts",
    "hii:governed-proposal-launch:check": "node scripts/hii-governed-proposal-launch-smoke.mjs",
    "hii:launch-proof:check": "node --experimental-strip-types scripts/hii-launch-proof-smoke.mjs",
    "hii:spaces:host": "node --experimental-strip-types scripts/hii-spaces-host.mjs",
    "hii:spaces:restart:check": "node --experimental-strip-types scripts/hii-spaces-restart-smoke.mjs",
    "hii:ecosystem:check": "vitest run tests/unit/hii-ecosystem.test.ts",
    "hii:bootstrap:check": "node scripts/hii-shell-syntax-check.mjs scripts/hii-bootstrap.sh",
    "hii:central:check": "node --check scripts/hii-release-installer.mjs && node --check scripts/hii-release-install-smoke.mjs && bash -n scripts/hii-install-release.sh && node scripts/hii-release-install-smoke.mjs",
    "hii:agent-home:check": "node scripts/hii-agent-home-smoke.mjs",
    "hii:interactive:check": "node scripts/hii-cli-interactive-smoke.mjs",
    "hii:central:install": "bash scripts/hii-install-release.sh",
    "hii:central:install:windows": "pwsh -NoProfile -NoLogo -File scripts/hii-install-release.ps1",
    "hii:launcher:check": "node scripts/hii-shell-syntax-check.mjs scripts/hii-launcher.sh && node scripts/hii-cli-launcher-smoke.mjs",
    "cli:check": "cargo fmt --all -- --check && cargo test --workspace && cargo clippy --workspace --all-targets -- -D warnings",
    "cli:build": "cargo build --workspace --release",
    "cli:install": "node scripts/hii-release-installer.mjs --source-root .",
    "llama:bundle": "node scripts/hii-llama-cpp-bundle.mjs",
    "llama:bundle:dry": "node scripts/hii-llama-cpp-bundle.mjs --dry-run",
    "bar:build": "node scripts/hii-bar-build.mjs",
    "bar:check": "node scripts/hii-bar-build.mjs --test",
    "cli:eval:local": "bash cli/scripts/local-model-eval.sh",
    "test": "vitest run",
    "security:secrets": "node scripts/hii-secret-scan.mjs",
    "licenses:check": "node scripts/hii-license-headers.mjs --check",
    "test:watch": "vitest",
    "ci:fast": "npm run security:secrets && npm run licenses:check && npm run check && npm run test && npm run hii:readme:check && npm run cli:check && npm run worker:check",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "stage:cli": "node scripts/hii-stage-cli.mjs",
    "worker:check": "cargo fmt --manifest-path workers/public-site/Cargo.toml -- --check && cargo test --manifest-path workers/public-site/Cargo.toml && cargo clippy --manifest-path workers/public-site/Cargo.toml --all-targets -- -D warnings",
    "personal:start": "node personal-workspace/server.mjs",
    "personal:check": "node --test personal-workspace/*.test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tauri-apps/api": "^2.11.1",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "fzstd": "0.1.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "stripe": "^17.2.0",
    "ws": "^8.21.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "allowScripts": {
    "workerd@1.20260918.1": true
  }
}
