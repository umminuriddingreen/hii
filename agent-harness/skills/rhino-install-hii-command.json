{
  "id": "rhino-install-hii-command",
  "name": "Install HII Rhino Command",
  "description": "Install the HII launcher as a Rhino alias in the active Rhino session via RhinoMCP.",
  "category": "system",
  "target": "local",
  "inputs": {
