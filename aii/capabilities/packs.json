    "runtimeFiles": ["Supabase capability_runners", "Supabase capability_jobs runner fields", "~/hii/.hii/termite-jobs.jsonl", "~/hii/.hii/termite-installer-runs.jsonl"],
    "verification": ["node scripts/hii-cli.mjs runner start --once", "npm run build"],
    "shipBoundary": "owned approved runners only; Rhino execution remains whitelisted and operator-reviewed"
  },
