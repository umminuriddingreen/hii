{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hii-stream-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "HiiStreamMCP", "class_name": "HiiStreamMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HiiStreamMCP"] }],
  "observability": { "enabled": true }
}
